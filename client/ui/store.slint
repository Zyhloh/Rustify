export struct PluginFinding {
    level: string,
    text: string,
}

export struct PluginInfo {
    id: string,
    kind: string,
    name: string,
    version: string,
    author: string,
    author-url: string,
    repository: string,
    repository-label: string,
    homepage: string,
    homepage-label: string,
    description: string,
    permissions: string,
    access: [string],
    error: string,
    enabled: bool,
    running: bool,
    valid: bool,
    risk: string,
    risk-title: string,
    findings: [PluginFinding],
    endpoints: string,
    icon: image,
    has-icon: bool,
    letter: string,
    tint: color,
    swatch-base: color,
    swatch-surface: color,
    swatch-raised: color,
    swatch-accent: color,
    swatch-text: color,
    swatch-dim: color,
    folder: string,
}

export struct PluginControl {
    plugin: string,
    id: string,
    label: string,
    icon: string,
    active: bool,
}

export struct PluginPageLink {
    plugin: string,
    id: string,
    title: string,
    icon: string,
}

export struct PluginBlock {
    kind: string,
    id: string,
    text: string,
    sub: string,
    value: float,
    min: float,
    max: float,
    input: string,
    on: bool,
    primary: bool,
    image-url: string,
    art: image,
}

export struct PluginSection {
    plugin: string,
    id: string,
    title: string,
    blocks: [PluginBlock],
}

export struct HiddenUi {
    friends: bool,
    news: bool,
    now-playing: bool,
    lyrics: bool,
    queue: bool,
    devices: bool,
    mini-player: bool,
    fullscreen: bool,
}

export struct PluginLog {
    plugin: string,
    level: string,
    text: string,
}

export global Plugins {
