export global Prefs {
    in-out property <bool> open-on-play: true;
    in-out property <bool> show-friends: true;
    in-out property <string> on-close: "tray";
    in-out property <bool> start-with-windows;
    in-out property <bool> eq-on;
    in-out property <[float]> eq-bands: [0, 0, 0, 0, 0, 0];
    in-out property <string> eq-preset: "Flat";
    in-out property <string> audio-level: "normal";
    in-out property <bool> mono;
    in-out property <string> volume-curve: "natural";
    in-out property <int> fade;
    in-out property <string> quality: "very_high";
    in-out property <bool> normalize: true;

    callback changed();
    callback audio-changed();
    callback set-band(int, float);
    callback preset-menu(length, length);
}

