export struct CardData {
    id: string,
    uri: string,
    kind: string,
    title: string,
    subtitle: string,
    image-url: string,
    art: image,
    pinned: bool,
}

export struct SectionData {
    eyebrow: string,
    title: string,
    items: [CardData],
}

export struct ArtistData {
    id: string,
    name: string,
    image-url: string,
    art: image,
    followers: string,
    genres: string,
    following: bool,
    loaded: bool,
}

export struct TrackData {
    index: int,
    id: string,
    uri: string,
    album-id: string,
    title: string,
    artists: string,
    album: string,
    added: string,
    duration: string,
    explicit: bool,
    image-url: string,
    art: image,
}

export struct ShowData {
    id: string,
    uri: string,
    kind: string,
    title: string,
    publisher: string,
    description: string,
    meta: string,
    saved: bool,
    image-url: string,
    art: image,
}

export struct EpisodeData {
    id: string,
    uri: string,
    title: string,
    description: string,
    date: string,
    duration: string,
    explicit: bool,
    show: string,
    show-id: string,
    image-url: string,
    art: image,
}

export struct ReleaseData {
    card: CardData,
    date: string,
    kind: string,
    detail: string,
}

export struct CollectionData {
    id: string,
    uri: string,
    context: string,
    kind: string,
    label: string,
    title: string,
    description: string,
    owner: string,
    owner-is-me: bool,
    meta: string,
    image-url: string,
    art: image,
    show-album: bool,
    show-added: bool,
    show-added-by: bool,
    show-art: bool,
    owner-id: string,
    owner-image-url: string,
    owner-art: image,
}

export struct PickerItem {
    id: string,
    kind: string,
    title: string,
    subtitle: string,
    image-url: string,
    art: image,
    checked: bool,
}

export struct TileData {
    key: string,
    title: string,
    color: color,
    image-url: string,
    art: image,
}

export struct LyricLine {
    start: float,
    end: float,
    text: string,
}

export struct DeviceData {
    id: string,
    name: string,
    kind: string,
    active: bool,
    current: bool,
}

export struct FriendData {
    name: string,
    image-url: string,
    art: image,
    track: string,
    track-uri: string,
    artist: string,
    context: string,
    context-uri: string,
    ago: string,
}

export struct ProfileData {
    id: string,
    name: string,
    image-url: string,
    art: image,
    followers: int,
    following: int,
    playlists: int,
    is-me: bool,
}

export struct NamedItem {
    id: string,
    name: string,
}

export struct ArtistPageData {
    id: string,
    uri: string,
    name: string,
    image-url: string,
    art: image,
    followers: string,
    following: bool,
    listeners: string,
    verified: bool,
}

