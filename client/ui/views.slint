import { Theme, Fmt } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, Slider, LikeButton } from "components.slint";
import { PlayButton, PlayerBar } from "playerbar.slint";
import { Player, Shell, Panels } from "store.slint";

component FullscreenLyrics inherits Rectangle {
    property <length> column: min(980px, root.width - 96px);
    property <length> follow-y: 0px;
    animate follow-y { duration: 420ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    changed follow-y => {
        flick.content-y = -max(0px, min(root.follow-y, flick.content-height - flick.height));
    }

    flick := Flickable {
        visible: Panels.lyrics-state == "ready";
        content-width: root.width;
        content-height: lines.preferred-height;

        lines := VerticalLayout {
            x: (root.width - root.column) / 2;
            width: root.column;
            padding-top: root.height * 0.3;
            padding-bottom: root.height * 0.5;
            spacing: 28px;

            for line in Panels.lyrics: Rectangle {
                property <bool> sung: Panels.lyrics-synced && Player.position >= line.end;
                property <bool> current: Panels.lyrics-synced && Player.position >= line.start && Player.position < line.end;
                changed current => {
                    if self.current {
                        root.follow-y = self.y - flick.height * 0.32;
                    }
                }

                height: text.preferred-height;

                ta := TouchArea {
                    mouse-cursor: Panels.lyrics-synced ? pointer : default;
                    clicked => {
                        if Panels.lyrics-synced {
                            Player.seek(line.start);
                        }
                    }
                }

                text := Text {
                    width: parent.width;
                    text: line.text == "" ? "♪" : line.text;
                    wrap: word-wrap;
                    font-size: min(56px, max(30px, root.width / 30));
                    font-weight: 800;
                    letter-spacing: -0.6px;
                    color: !Panels.lyrics-synced ? #ffffffd9 : parent.current ? #ffffff : parent.sung ? #ffffff73 : ta.has-hover ? #ffffffe6 : #ffffffb3;
                    animate color { duration: 260ms; }
                }
            }

            if Panels.lyrics-provider != "": Text {
                text: "Lyrics provided by \{Panels.lyrics-provider}";
                color: #ffffffb3;
                font-size: 14px;
            }
        }
    }

    if Panels.lyrics-state != "ready": VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            horizontal-alignment: center;
            text: Panels.lyrics-state == "loading" ? "Loading lyrics…" : "No lyrics for this one";
            color: Theme.text;
            font-size: 32px;
            font-weight: 800;
        }

        if Panels.lyrics-state == "none": Text {
            horizontal-alignment: center;
            text: "Spotify doesn't have lyrics for this song yet.";
            color: #ffffffb3;
            font-size: 16px;
        }
    }
}

export component FullscreenView inherits Rectangle {
    property <length> bar: 72px;
    property <length> stage-height: root.height - root.bar - 16px;
    property <length> art: max(160px, min(min(root.stage-height - 200px, root.width * 0.5), 640px));
    property <bool> lyrics: Shell.fullscreen-lyrics && Player.has-track;
    property <color> tint: root.lyrics && Panels.lyrics-state == "ready" ? Panels.lyrics-color.mix(#000000, 0.55) : Player.art-color;

    background: #000000;
    forward-focus: keys;

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                Shell.toggle-fullscreen();
                return accept;
            }
            if event.text == " " {
                Player.toggle();
                return accept;
            }
            return reject;
        }

        stage := Rectangle {
            x: 8px;
            y: 8px;
            width: root.width - 16px;
            height: root.stage-height;
            border-radius: 8px;
            clip: true;
            background: @linear-gradient(180deg, root.tint.brighter(0.12) 0%, root.tint 45%, root.tint.darker(0.3) 100%);

            TouchArea {
                double-clicked => { Shell.toggle-fullscreen(); }
            }

            if !root.lyrics: Rectangle {
                x: (parent.width - root.art) / 2;
                y: max(72px, (parent.height - root.art) / 2);
                width: root.art;
                height: root.art;
                border-radius: 8px;
                background: Theme.surface-high;
                drop-shadow-blur: 64px;
                drop-shadow-offset-y: 16px;
                drop-shadow-color: #00000080;

                Rectangle {
                    border-radius: 8px;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: Player.art-large;
                        image-fit: cover;
                        image-rendering: smooth;
                    }
                }
            }

            if root.lyrics: FullscreenLyrics {
                y: 64px;
                height: parent.height - 64px;
            }

            if root.lyrics: Rectangle {
                y: 0;
                height: 88px;
                background: @linear-gradient(180deg, root.tint.brighter(0.12) 45%, root.tint.brighter(0.12).transparentize(1) 100%);
            }

            Text {
                x: 22px;
                y: 22px;
                width: parent.width - 260px;
                text: Player.context-title != "" ? Player.context-title : Player.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
            }

            HorizontalLayout {
                x: parent.width - self.preferred-width - 14px;
                y: 14px;
                height: 36px;
                spacing: 4px;

                IconButton {
                    icon: Icons.album;
                    icon-size: 18px;
                    dot: true;
                    active: !root.lyrics;
                    idle-color: #ffffffb3;
                    clicked => {
                        Shell.fullscreen-lyrics = false;
                        Shell.fullscreen-lyrics-changed();
                    }
                }

                IconButton {
                    icon: Icons.lyrics;
                    icon-size: 18px;
                    dot: true;
                    active: root.lyrics;
                    enabled: Player.has-track;
                    idle-color: #ffffffb3;
                    clicked => {
                        Shell.fullscreen-lyrics = true;
                        Shell.fullscreen-lyrics-changed();
                    }
                }

                Rectangle {
                    width: 17px;

                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: #ffffff33;
                    }
                }

                IconButton {
                    icon: Icons.collapse;
                    icon-size: 18px;
                    idle-color: #ffffffb3;
                    clicked => { Shell.toggle-fullscreen(); }
                }
            }
        }

        PlayerBar {
            y: root.height - root.bar - 4px;
            width: root.width;
            background: #000000;
        }
    }
}

export component MiniView inherits Rectangle {
    property <bool> hovering: area.has-hover;

    background: #000000;
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        source: Player.art-large;
        image-fit: cover;
        opacity: Player.art-large.width > 0 ? 1 : 0;
        animate opacity { duration: 400ms; }
    }

    if !Player.has-track: Icon {
        d: Icons.note;
        size: 56px;
        color: Theme.text-faint;
    }

    Rectangle {
        background: @linear-gradient(180deg, #00000099 0%, #00000000 30%, #00000000 45%, #000000e6 100%);
        opacity: root.hovering || !Player.playing ? 1 : 0.85;
        animate opacity { duration: 200ms; }
    }

    area := TouchArea {
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                Shell.drag();
            }
        }

        HorizontalLayout {
            x: 8px;
            y: 8px;
            width: root.width - 16px;
            height: 32px;
            alignment: end;
            spacing: 4px;
            opacity: root.hovering ? 1 : 0;
            animate opacity { duration: 200ms; }

            IconButton {
                icon: Icons.expand;
                icon-size: 16px;
                idle-color: #ffffffd9;
                clicked => { Shell.exit-mini(); }
            }

            IconButton {
                icon: Icons.win-close;
                icon-size: 16px;
                idle-color: #ffffffd9;
                clicked => { Shell.exit-mini(); }
            }
        }

        VerticalLayout {
            x: 16px;
            y: root.height - 128px;
            width: root.width - 32px;
            height: 116px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        text: Player.has-track ? Player.title : "Nothing playing";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        text: Player.artists;
                        color: #ffffffb3;
                        font-size: 13px;
                        overflow: elide;
                    }
                }

                if Player.has-track && Player.likeable: LikeButton {
                    y: 4px;
                    liked: Player.saved;
                    toggled => { Player.save-pressed(); }
                }
            }

            Slider {
                value: Player.duration > 0 ? Player.position / Player.duration : 0;
                committed(v) => { Player.seek(v * Player.duration); }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 20px;
                height: 40px;

                IconButton {
                    y: 4px;
                    icon: Icons.prev;
                    filled: true;
                    icon-size: 18px;
                    enabled: Player.ready;
                    idle-color: #ffffffd9;
                    clicked => { Player.prev(); }
                }

                PlayButton { y: 2px; size: 36px; }

                IconButton {
                    y: 4px;
                    icon: Icons.next;
                    filled: true;
                    icon-size: 18px;
                    enabled: Player.ready;
                    idle-color: #ffffffd9;
                    clicked => { Player.next(); }
                }
            }
        }
    }
}
