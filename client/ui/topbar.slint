import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton } from "components.slint";
import { Store, Shell, Panels, Prefs, Plugins } from "store.slint";

component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger: false;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: ta.pressed ? (root.danger ? #c50f1f : Theme.press) : ta.has-hover ? (root.danger ? Theme.danger : Theme.tile) : transparent;
    animate background { duration: Theme.fast; }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    Icon {
        d: root.icon;
        size: 16px;
        weight: 1.4px;
        color: ta.has-hover ? Theme.text : Theme.text-dim;
        transform-scale: ta.pressed ? 0.88 : 1;
        animate color { duration: Theme.fast; }
        animate transform-scale { duration: 120ms; easing: ease-out; }
    }
}

component SearchBox inherits Rectangle {
    property <bool> engaged: ta.has-hover || input.has-focus;
    property <int> focus-request: Store.focus-search-request;
    changed focus-request => { input.focus(); input.select-all(); }

    height: 48px;
    border-radius: 24px;
    background: root.engaged ? Theme.surface-high : Theme.surface-raised;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.text : ta.has-hover ? #ffffff26 : transparent;
    animate background, border-color { duration: Theme.medium; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: text;
        clicked => { input.focus(); }
    }

    Icon {
        x: 14px;
        d: Icons.search;
        size: 22px;
        color: root.engaged ? Theme.text : Theme.text-dim;
        animate color { duration: Theme.medium; }
    }

    Text {
        x: 50px;
        visible: input.text == "";
        text: "What do you want to play?";
        color: Theme.text-dim;
        font-size: 16px;
        overflow: elide;
        width: parent.width - 180px;
    }

    if input.text == "" && input.has-focus: HorizontalLayout {
        x: parent.width - 62px - self.preferred-width - 12px;
        y: (parent.height - 22px) / 2;
        height: 22px;
        spacing: 4px;
        for key in ["Ctrl", "L"]: Rectangle {
            width: key-text.preferred-width + 10px;
            border-radius: 4px;
            border-width: 1px;
            border-color: #ffffff4d;
            key-text := Text { text: key; color: Theme.text-dim; font-size: 12px; }
        }
    }

    input := TextInput {
        x: 50px;
        width: parent.width - 120px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 16px;
        single-line: true;
        selection-background-color: #1ed76066;
        text <=> Store.search-query;
        edited => { Store.search-edited(self.text); }
        changed has-focus => {
            Store.search-focused = self.has-focus;
            if self.has-focus {
                Store.search-focus();
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                Store.blur-search-request += 1;
                return accept;
            }
            return reject;
        }
    }

    if input.text != "": IconButton {
        x: parent.width - 98px;
        y: 8px;
        icon: Icons.close;
        icon-size: 18px;
        clicked => {
            input.text = "";
            Store.search-edited("");
            input.focus();
        }
    }

    Rectangle {
        x: parent.width - 62px;
        width: 1px;
        height: 24px;
        background: #ffffff33;
    }

    IconButton {
        x: parent.width - 52px;
        y: 8px;
        icon: Icons.browse;
        icon-size: 22px;
        active: Store.page == "search" && Store.search-query == "";
        active-color: Theme.text;
        clicked => {
            Store.search-query = "";
            Store.search-edited("");
            Store.search-focus();
        }
    }
}

export component TopBar inherits Rectangle {
    max-width: 100000px;
    height: 64px;
    background: Theme.base;

    TouchArea {
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                Shell.drag();
            }
        }
        double-clicked => { Shell.maximize(); }
    }

    HorizontalLayout {
        x: 16px;
        alignment: start;
        spacing: 8px;
        dots := IconButton {
            y: 16px;
            icon: Icons.dots;
            filled: true;
            ghost: true;
            clicked => { Store.app-menu(self.absolute-position.x, self.absolute-position.y + self.height + 6px); }
        }
        Rectangle { width: 8px; }
        IconButton { y: 16px; icon: Icons.back; icon-size: 20px; ghost: true; enabled: Store.can-back; clicked => { Store.go-back(); } }
        IconButton { y: 16px; icon: Icons.forward; icon-size: 20px; ghost: true; enabled: Store.can-forward; clicked => { Store.go-forward(); } }
        if Plugins.topbar.length > 0: Rectangle { width: 4px; }
        for button in Plugins.topbar: IconButton {
            y: 16px;
            icon: button.icon;
            icon-size: 20px;
            ghost: true;
            active: button.active;
            active-color: Theme.text;
            clicked => { Plugins.click(button.plugin, button.id); }
        }
    }

    HorizontalLayout {
        property <length> search-width: max(180px, min(474px, root.width - 2 * (root.width >= 960px ? 290px : 210px) - 56px));
        x: (root.width - self.width) / 2;
        y: 8px;
        height: 48px;
        width: 48px + 8px + search-width;
        spacing: 8px;

        Rectangle {
            width: 48px;
            border-radius: 24px;
            background: home-ta.has-hover ? Theme.surface-high : Theme.surface-raised;
            transform-scale: home-ta.pressed ? 0.94 : home-ta.has-hover ? 1.04 : 1;
            animate background { duration: Theme.fast; }
            animate transform-scale { duration: 140ms; easing: ease-out; }

            home-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Store.go-home(); }
            }

            Icon {
                d: Icons.home;
                filled: Store.page == "home";
                size: 24px;
                color: Store.page == "home" ? Theme.text : (home-ta.has-hover ? Theme.text : Theme.text-dim);
            }
        }

        SearchBox { }
    }

    HorizontalLayout {
        x: root.width - self.width - 12px;
        height: root.height;
        alignment: end;
        spacing: 4px;

        if root.width >= 960px && Plugins.system: IconButton {
            y: 16px;
            icon: Icons.puzzle;
            ghost: true;
            active: Store.page == "extensions" || Store.page == "extension";
            active-color: Theme.text;
            clicked => { Plugins.open-manager(); }
        }
        if root.width >= 960px: IconButton {
            y: 16px;
            icon: Icons.bell;
            ghost: true;
            active: Store.page == "news";
            clicked => { Store.open-news(); }
        }
        if root.width >= 960px && Prefs.show-friends: IconButton {
            y: 16px;
            icon: Icons.friends;
            ghost: true;
            active: Shell.right-panel == "friends";
            active-color: Theme.text;
            clicked => { Panels.open-panel("friends"); }
        }

        Rectangle {
            y: 8px;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: avatar-ta.has-hover ? Theme.surface-high : Theme.surface-raised;
            animate background { duration: Theme.fast; }

            avatar-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Store.account-menu-open = !Store.account-menu-open; }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: #535353;
                clip: true;
                transform-scale: avatar-ta.pressed ? 0.94 : avatar-ta.has-hover ? 1.06 : 1;
                animate transform-scale { duration: 140ms; easing: ease-out; }

                Text {
                    text: Store.user-initial;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                }

                Image {
                    width: 100%;
                    height: 100%;
                    source: Store.user-art;
                    image-fit: cover;
                    opacity: Store.user-art.width > 0 ? 1 : 0;
                    animate opacity { duration: 260ms; }
                }
            }
        }

        Rectangle {
            width: 17px;
            Rectangle {
                width: 1px;
                height: 20px;
                background: #ffffff1f;
            }
        }

        WindowButton { y: 16px; icon: Icons.win-minimize; clicked => { Shell.minimize(); } }
        WindowButton { y: 16px; icon: Shell.maximized ? Icons.win-restore : Icons.win-maximize; clicked => { Shell.maximize(); } }
        WindowButton { y: 16px; icon: Icons.win-close; danger: true; clicked => { Shell.close(); } }
    }
}

export component Chrome inherits Rectangle {
    height: 64px;

    TouchArea {
        pointer-event(ev) => {
            if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                Shell.drag();
            }
        }
        double-clicked => { Shell.maximize(); }
    }

    HorizontalLayout {
        padding-right: 8px;
        alignment: end;
        spacing: 4px;

        WindowButton { y: 16px; icon: Icons.win-minimize; clicked => { Shell.minimize(); } }
        WindowButton { y: 16px; icon: Shell.maximized ? Icons.win-restore : Icons.win-maximize; clicked => { Shell.maximize(); } }
        WindowButton { y: 16px; icon: Icons.win-close; danger: true; clicked => { Shell.close(); } }
    }
}
