import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Chip, Scroller, Bleed } from "components.slint";
import { Store, Player, ReleaseData } from "store.slint";

component ReleaseRow inherits Rectangle {
    in property <ReleaseData> data;
    property <bool> active: Player.context-uri != "" && Player.context-uri == root.data.card.uri;
    property <length> art-size: root.width > 520px ? 112px : 72px;

    height: root.art-size + 32px;
    border-radius: 8px;
    background: ta.has-hover || play-ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Store.open-card(root.data.card); }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                Store.card-menu(root.data.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Rectangle {
        x: 16px;
        y: 0;
        width: parent.width - 32px;
        height: 1px;
        background: #ffffff12;
    }

    HorizontalLayout {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        height: root.art-size;
        spacing: 24px;

        Rectangle {
            width: root.art-size;
            border-radius: 6px;
            background: Theme.surface-high;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.data.card.art;
                image-fit: cover;
                opacity: root.data.card.art.width > 0 ? 1 : 0;
                animate opacity { duration: 220ms; }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: root.data.card.title;
                color: root.active ? Theme.accent : Theme.text;
                font-size: 16px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.data.card.subtitle;
                color: Theme.text;
                font-size: 14px;
                overflow: elide;
            }

            Text {
                text: root.data.detail + "  •  " + root.data.date;
                color: Theme.text-dim;
                font-size: 13px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 40px;
            height: 40px;
            y: (root.art-size - 40px) / 2;
            border-radius: 20px;
            background: play-ta.has-hover ? Theme.text : #ffffffe6;
            opacity: ta.has-hover || play-ta.has-hover || root.active ? 1 : 0;
            transform-scale: play-ta.pressed ? 0.94 : play-ta.has-hover ? 1.05 : 1;
            animate opacity, transform-scale { duration: Theme.fast; }

            Icon {
                d: root.active && Player.playing ? Icons.pause : Icons.play;
                filled: true;
                size: 18px;
                color: #000000;
            }

            play-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.active {
                        Player.toggle();
                    } else {
                        Store.play-card(root.data.card);
                    }
                }
            }
        }
    }
}

export component NewsPage inherits Rectangle {
    max-width: 100000px;
    background: Theme.surface;
    border-radius: Theme.radius;
    clip: true;

    Scroller {
        content-height: body.preferred-height;

        body := VerticalLayout {
            width: parent.width;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 32px;
            padding-bottom: 32px;
            spacing: 8px;

            Text {
                text: "What's New";
                color: Theme.text;
                font-size: 32px;
                font-weight: 800;
                letter-spacing: -1px;
            }

            Text {
                text: "The latest releases from artists, podcasts, and shows you follow.";
                color: Theme.text-dim;
                font-size: 14px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-top: 16px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                height: 56px;

                for chip in [
                    { key: "music", label: "Music" },
                    { key: "podcast", label: "Podcast & Shows" },
                ]: Chip {
                    text: chip.label;
                    active: Store.news-filter == chip.key;
                    clicked => { Store.filter-news(Store.news-filter == chip.key ? "" : chip.key); }
                }
            }

            if Store.news-loading: VerticalLayout {
                spacing: 16px;
                for _ in 4: Rectangle {
                    height: 112px;
                    border-radius: 8px;
                    background: Theme.tile;
                    opacity: 0.5;
                }
            }

            if !Store.news-loading && Store.news.length == 0: VerticalLayout {
                padding-top: 48px;
                spacing: 8px;

                Text {
                    horizontal-alignment: center;
                    text: "We don't have any updates for you yet";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 800;
                }

                Text {
                    horizontal-alignment: center;
                    text: "When there's news, we'll post it here. Follow your favorite artists and podcasts to stay updated on them too.";
                    color: Theme.text-dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }

            Bleed {
                amount: 16px;

                for release in Store.news: ReleaseRow {
                    data: release;
                }
            }
        }
    }
}
